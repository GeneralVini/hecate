<?xml version="1.0"?>
<ruleset name="HECATE">
    <description>PHPCS do HECATE baseado em PSR-12.</description>

    <arg name="basepath" value="."/>
    <arg name="colors"/>
    <arg name="parallel" value="8"/>

    <file>src</file>
    <file>config</file>
    <file>public/index.php</file>
    <file>tests</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/runtime/*</exclude-pattern>
    <exclude-pattern>*/public/assets/*</exclude-pattern>

    <rule ref="PSR12"/>
</ruleset>
