{
    "name": "generalvini/hecate",
    "type": "project",
    "description": "HECATE - Plataforma Institucional de Governança e Controle de Impressão",
    "license": "proprietary",
    "minimum-stability": "stable",
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./yii serve"
        ],
        "lint": "ecs check --ansi",
        "lint:fix": "ecs check --ansi --fix",
        "rector": "rector process --dry-run --no-progress-bar",
        "rector:fix": "rector process --no-progress-bar",
        "stan": "phpstan analyse --configuration=phpstan.neon --no-progress",
        "psalm": "psalm --config=psalm.xml --no-progress",
        "psalm:taint": "psalm --config=psalm.xml --taint-analysis --no-progress",
        "test": "phpunit --configuration=phpunit.xml",
        "security:dependencies": "@composer audit --locked --no-interaction",
        "security": [
            "@security:dependencies",
            "@psalm:taint"
        ],
        "fix": [
            "@rector:fix",
            "@lint:fix"
        ],
        "qa": [
            "@lint",
            "@rector",
            "@stan",
            "@psalm",
            "@test"
        ],
        "check": [
            "@qa",
            "@security"
        ]
    },
    "require": {
        "php": "8.2 - 8.5",
        "ext-filter": "*",
        "ext-pdo": "*",
        "httpsoft/http-message": "^1.1.6",
        "psr/container": "^2.0.2",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "psr/http-server-handler": "^1.0.2",
        "psr/log": "^3.0.2",
        "psr/simple-cache": "^3.0",
        "symfony/console": "^7.4.7 || ^8.0.7",
        "yiisoft/active-record": "^1.1",
        "yiisoft/aliases": "^3.1.1",
        "yiisoft/assets": "^5.1.2",
        "yiisoft/cache": "^3.0",
        "yiisoft/config": "^1.6.2",
        "yiisoft/csrf": "^2.2.3",
        "yiisoft/db-migration": "^2.1",
        "yiisoft/db-pgsql": "^2.0",
        "yiisoft/definitions": "^3.4.1",
        "yiisoft/di": "^1.4.1",
        "yiisoft/error-handler": "^4.3.2",
        "yiisoft/html": "^4",
        "yiisoft/http": "^1.3",
        "yiisoft/input-http": "^1.0.1",
        "yiisoft/log": "^2.2.0",
        "yiisoft/middleware-dispatcher": "^5.4",
        "yiisoft/request-provider": "^1.3",
        "yiisoft/router": "^4.0.2",
        "yiisoft/router-fastroute": "^4.0.3",
        "yiisoft/session": "^3.0.1",
        "yiisoft/view": "^12.2.4",
        "yiisoft/yii-console": "^2.4.2",
        "yiisoft/yii-http": "^1.1.1",
        "yiisoft/yii-runner-console": "^2.2.1",
        "yiisoft/yii-runner-http": "^3.2.1",
        "yiisoft/yii-view-renderer": "^7.4.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.10",
        "phpunit/phpunit": "^11.5",
        "rector/rector": "^2.6",
        "symplify/easy-coding-standard": "^13.2",
        "vimeo/psalm": "^6.17",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests"
        }
    },
    "extra": {
        "config-plugin-file": "config/configuration.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "yiisoft/config": true
        }
    }
}
